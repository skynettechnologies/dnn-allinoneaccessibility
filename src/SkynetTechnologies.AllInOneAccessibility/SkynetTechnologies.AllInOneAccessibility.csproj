<Project Sdk="Microsoft.NET.Sdk">

  <!--
    All in One Accessibility for DNN.
    Build in Visual Studio 2026 (or `dotnet build -c Release`). Requires the .NET Framework 4.8 targeting pack.

    DnnRoot must point at a DNN 10 website; the DNN assemblies are referenced from its bin folder.
    Override it without editing this file:  dotnet build -c Release -p:DnnRoot="D:\Sites\MyDnn"

    Release build  -> creates dist\AllInOneAccessibility_01.00.00_Install.zip (install it from Settings > Extensions).
    Debug build    -> also copies the DLL and Persona Bar files straight into DnnRoot for quick testing
                      (only after the package has been installed once, so the menu item exists).
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SkynetTechnologies.AllInOneAccessibility</AssemblyName>
    <RootNamespace>SkynetTechnologies.AllInOneAccessibility</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DnnRoot Condition="'$(DnnRoot)' == ''">C:\inetpub\dnn</DnnRoot>
    <DnnBin>$(DnnRoot)\bin</DnnBin>
    <PackageVersion>01.00.00</PackageVersion>
    <DistDir>$(MSBuildProjectDirectory)\..\..\dist\</DistDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Net.Http" />
    <Reference Include="DotNetNuke">
      <HintPath>$(DnnBin)\DotNetNuke.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DotNetNuke.Web">
      <HintPath>$(DnnBin)\DotNetNuke.Web.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DotNetNuke.Abstractions">
      <HintPath>$(DnnBin)\DotNetNuke.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DotNetNuke.Instrumentation">
      <HintPath>$(DnnBin)\DotNetNuke.Instrumentation.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dnn.PersonaBar.Library">
      <HintPath>$(DnnBin)\Dnn.PersonaBar.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Web.Http">
      <HintPath>$(DnnBin)\System.Web.Http.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DnnBin)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="AllInOneAccessibility.dnn;License.txt;ReleaseNotes.txt;Install\**;PersonaBar\**" />
  </ItemGroup>

  <!-- Builds the installable DNN package (Release only). -->
  <Target Name="PackageExtension" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PkgStage>$(MSBuildProjectDirectory)\obj\package\</PkgStage>
      <ResStage>$(MSBuildProjectDirectory)\obj\resources\</ResStage>
    </PropertyGroup>
    <ItemGroup>
      <AioaPersonaBarFiles Include="PersonaBar\**\*.*" />
    </ItemGroup>

    <RemoveDir Directories="$(PkgStage);$(ResStage)" />
    <Copy SourceFiles="@(AioaPersonaBarFiles)" DestinationFiles="@(AioaPersonaBarFiles->'$(ResStage)%(RecursiveDir)%(Filename)%(Extension)')" />
    <MakeDir Directories="$(PkgStage);$(DistDir)" />
    <ZipDirectory SourceDirectory="$(ResStage)" DestinationFile="$(PkgStage)Resources.zip" Overwrite="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PkgStage)bin" />
    <Copy SourceFiles="AllInOneAccessibility.dnn;License.txt;ReleaseNotes.txt" DestinationFolder="$(PkgStage)" />
    <Copy SourceFiles="Install\01.00.00.SqlDataProvider;Install\Uninstall.SqlDataProvider" DestinationFolder="$(PkgStage)Install" />
    <ZipDirectory SourceDirectory="$(PkgStage)" DestinationFile="$(DistDir)AllInOneAccessibility_$(PackageVersion)_Install.zip" Overwrite="true" />
    <Message Importance="high" Text="DNN package created: $(DistDir)AllInOneAccessibility_$(PackageVersion)_Install.zip" />
  </Target>

  <!-- Debug convenience: push the build straight into the local DNN site. -->
  <Target Name="DeployToLocalDnn" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' And Exists('$(DnnRoot)\DesktopModules\Admin\Dnn.PersonaBar\Modules\AllInOneAccessibility')">
    <ItemGroup>
      <AioaDeployFiles Include="PersonaBar\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(DnnBin)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="@(AioaDeployFiles)" DestinationFiles="@(AioaDeployFiles->'$(DnnRoot)\DesktopModules\Admin\Dnn.PersonaBar\Modules\AllInOneAccessibility\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Message Importance="high" Text="Deployed to $(DnnRoot)" />
  </Target>

</Project>
